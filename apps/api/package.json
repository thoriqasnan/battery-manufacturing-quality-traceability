{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:authentication": "vitest run --config ./vitest.config.authentication.ts",
    "test:authorization": "vitest run --config ./vitest.config.authorization.ts",
    "test:security-hardening": "vitest run --config ./vitest.config.security-hardening.ts",
    "test:auth-transport": "vitest run --config ./vitest.config.auth-transport.ts",
    "test:traceability": "vitest run --config ./vitest.config.traceability.ts",
    "test:user-persistence": "vitest run --config ./vitest.config.user-persistence.ts",
    "test:dev-users": "vitest run --config ./vitest.config.dev-users.ts",
    "test:dashboard": "vitest run --config ./vitest.config.dashboard.ts",
    "test:traceability-search": "vitest run --config ./vitest.config.traceability-search.ts",
    "test:traceability-detail": "vitest run --config ./vitest.config.traceability-detail.ts",
    "traceability:evidence": "tsc --incremental false && node dist/scripts/traceability-evidence.js",
    "phase2:verify": "prisma format && npm run prisma:validate && npm run prisma:generate && prisma migrate status && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code && tsc --noEmit && npm run lint && npm run test && npm run test:traceability && npm run test:e2e && npm run build && git diff --check",
    "db:seed": "npm run prisma:generate && tsc --incremental false && node prisma/seed.mjs",
    "dev:users": "tsc --incremental false && node dist/scripts/provision-acceptance-users.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
